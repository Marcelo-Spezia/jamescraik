# Plantilla de configuración. Copiá este archivo a `.env` y completá los valores.
# El archivo `.env` está en .gitignore y NUNCA se sube al repo.

# Credencial de Anthropic (Claude) — necesaria para el JudgeModel real (--live).
# Generala en https://console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=sk-ant-...

# Credencial de Apollo (master key) — necesaria para el enrichment de empresas.
APOLLO_API_KEY=

# Contraseña de acceso a la app desplegada. Si está vacía (dev local), la app queda
# abierta; si la seteás (en Secrets del host), pide contraseña para entrar.
APP_PASSWORD=

# Idioma con el que abre la app: es | en (default es). La UI tiene selector 🌐 igual.
# Para la demo a un cliente en inglés, poné en=en en los Secrets del host.
APP_DEFAULT_LANG=es

# Actividad de LinkedIn (Fase 2). URL de entrada de tu tabla de Clay: con esto el botón
# "Traer actividad" dispara el enriquecimiento en Clay. Sin esto, usa el stub (demo).
CLAY_WEBHOOK_URL=
# Modo demo de actividad (muestra un ejemplo [DEMO] sin proveedor): ICP_ACTIVITY_DEMO=1

# Opcional: modelo del juez (default claude-opus-4-8) — enrichment, mensaje, chat.
# ICP_JUDGE_MODEL=claude-opus-4-8
# Opcional: modelo de la CALIFICACIÓN (default claude-haiku-4-5, ~5x más barato).
# Poné claude-opus-4-8 si querés máxima calidad en el tiering.
# ICP_QUALIFY_MODEL=claude-haiku-4-5
# Opcional: tamaño de tanda del enrichment (default 5).
# ICP_ENRICH_BATCH=5
